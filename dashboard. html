                <input type="tel" id="phone" name="phone"
                       placeholder="e.g. 0712345678" required>
            </div>

            <div class="form-group">
                <label for="alt_phone">Alternative Phone Number</label>
                <input type="tel" id="alt_phone" name="alt_phone">
            </div>

            <div class="form-group full-width">
                <label for="email">Email Address (optional)</label>
                <input type="email" id="email" name="email">
            </div>

        </div>

        <h2 class="section-title">3. Emergency and Medical Information</h2>

        <div class="form-grid">

            <div class="form-group">
                <label for="emergency_name">Emergency Contact Name</label>
                <input type="text" id="emergency_name" name="emergency_name">
            </div>

            <div class="form-group">
                <label for="emergency_phone">Emergency Contact Phone</label>
                <input type="tel" id="emergency_phone" name="emergency_phone">
            </div>

            <div class="form-group full-width">
                <label for="medical">Medical Conditions / Allergies</label>
                <textarea id="medical" name="medical"
                          placeholder="Provide relevant information, or write None"></textarea>
            </div>

        </div>

        <h2 class="section-title">4. Declaration</h2>

        <div class="form-group">
            <label for="declaration">Parent/Guardian Declaration *</label>
            <textarea id="declaration" name="declaration"
                      placeholder="I confirm that the information provided is correct."
                      required></textarea>
        </div>

        <div class="checkbox">
            <input type="checkbox" id="confirm" required>
            <label for="confirm">
                I confirm that the information provided is accurate and agree
                to the school's admission procedures.
            </label>
        </div>

        <button type="submit">Submit Admission Application</button>

    </form>

