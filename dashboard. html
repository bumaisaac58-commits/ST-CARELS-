<!-- Load Supabase library first -->
<script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>

<!-- Your Supabase configuration -->
<script src="supabase.js"></script>

<script>
document.getElementById("academicYear").textContent =
    new Date().getFullYear();

document.getElementById("footerYear").textContent =
    new Date().getFullYear();

const statusBox = document.getElementById("connectionStatus");

function getSupabaseClient() {
    return window.supabaseClient || window.db || null;
}

async function loadTeacherDashboard() {
    const db = getSupabaseClient();

    if (!db) {
        statusBox.textContent =
            "Supabase client not initialized. Check your supabase.js file.";
        return;
    }

    try {
        // Verify that a user is logged in.
        const { data: sessionData, error: authError } =
            await db.auth.getUser();

        if (authError || !sessionData.user) {
            statusBox.textContent =
                "Please log in using your St Carels teacher account.";

            return;
        }

        statusBox.textContent =
            "Teacher authenticated. Checking school records...";

        /*
          These queries require the relevant tables and RLS policies.
          Replace the table names or columns if your database differs.
        */

        const { data: students, error: studentError } = await db
            .from("students")
            .select("id, admission_no, full_name, grade");

        if (!studentError && students) {
            document.getElementById("studentCount").textContent =
                students.length;

            const tbody = document.getElementById("studentsTable");
            tbody.replaceChildren();

            if (students.length === 0) {
                tbody.innerHTML =
                    '<tr><td colspan="3">No students found.</td></tr>';
            } else {
                students.slice(0, 10).forEach(student => {
                    const row = document.createElement("tr");

                    [
                        student.admission_no || "-",
                        student.full_name || "-",
                        student.grade || "-"
                    ].forEach(value => {
                        const cell = document.createElement("td");
                        cell.textContent = value;
                        row.appendChild(cell);
                    });

                    tbody.appendChild(row);
                });
            }
        }

        const { data: classes, error: classError } = await db
            .from("grades")
            .select("id");

        if (!classError && classes) {
            document.getElementById("classCount").textContent =
                classes.length;
        }

        const { data: subjects, error: subjectError } = await db
            .from("subjects")
            .select("id");

        if (!subjectError && subjects) {
            document.getElementById("subjectCount").textContent =
                subjects.length;
        }

        const { data: assignments, error: assignmentError } = await db
            .from("assignments")
            .select("id");

        if (!assignmentError && assignments) {
            document.getElementById("assignmentCount").textContent =
                assignments.length;
        }

        statusBox.textContent =
            "Connected to Supabase. Available records have been loaded.";

    } catch (error) {
        statusBox.textContent =
            "Unable to load dashboard: " + error.message;
    }
}

document.getElementById("logoutLink").addEventListener("click", async function(e) {
    const db = getSupabaseClient();

    if (db) {
        e.preventDefault();

        const { error } = await db.auth.signOut();

        if (error) {
            statusBox.textContent =
                "Logout failed: " + error.message;
            return;
        }

        window.location.href = "login.html";
    }
});

loadTeacherDashboard();
</script>

