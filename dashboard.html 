
<!DOCTYPE html>
<html lang="en">
<head><link rel="stylesheet" href="style.css">
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>St Carels Academy | Dashboard</title>

<style>
* {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
    font-family: Arial, sans-serif;
}

body {
    background: #f1f5f9;
    color: #1e293b;
}

header {
    background: #0d47a1;
    color: white;
    padding: 18px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    flex-wrap: wrap;
}

header h2 {
    font-size: 20px;
}

header p {
    font-size: 12px;
    margin-top: 5px;
}

.logout {
    background: white;
    color: #0d47a1;
    border: none;
    border-radius: 8px;
    padding: 10px 15px;
    font-weight: bold;
    cursor: pointer;
}

.layout {
    display: flex;
    min-height: calc(100vh - 75px);
}

.sidebar {
    width: 230px;
    flex-shrink: 0;
    background: white;
    padding: 20px 12px;
    border-right: 1px solid #e2e8f0;
}

.sidebar h3 {
    color: #0d47a1;
    padding: 10px;
    margin-bottom: 12px;
}

.sidebar button {
    display: block;
    width: 100%;
    padding: 13px 12px;
    border: none;
    border-radius: 8px;
    background: transparent;
    color: #334155;
    text-align: left;
    cursor: pointer;
    margin-bottom: 5px;
    font-size: 14px;
}

.sidebar button:hover,
.sidebar button.active {
    background: #e3f2fd;
    color: #0d47a1;
    font-weight: bold;
}

main {
    flex: 1;
    min-width: 0;
    padding: 25px;
}

.welcome {
    margin-bottom: 25px;
}

.welcome h1 {
    font-size: 25px;
    margin-bottom: 8px;
    color: #0d47a1;
}

.welcome p {
    color: #64748b;
    font-size: 14px;
}

.cards {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 15px;
    margin-bottom: 25px;
}

.card {
    background: white;
    padding: 20px;
    border-radius: 12px;
    box-shadow: 0 2px 8px rgba(0,0,0,0.04);
    border-left: 4px solid #1976d2;
}

.card p {
    font-size: 13px;
    color: #64748b;
    margin-bottom: 12px;
}

.card h2 {
    color: #0d47a1;
    font-size: 27px;
}

.panel {
    background: white;
    padding: 22px;
    border-radius: 12px;
    margin-bottom: 20px;
    box-shadow: 0 2px 8px rgba(0,0,0,0.04);
}

.panel h2 {
    color: #0d47a1;
    margin-bottom: 15px;
    font-size: 19px;
}

.quick-actions {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 12px;
}

.action {
    padding: 16px 10px;
    border: 1px solid #dbeafe;
    border-radius: 10px;
    background: #f8fbff;
    color: #0d47a1;
    cursor: pointer;
    font-weight: bold;
}

.action:hover {
    background: #e3f2fd;
}

#pageContent {
    display: none;
}

footer {
    text-align: center;
    padding: 18px;
    font-size: 12px;
    color: #64748b;
}

.notice {
    padding: 14px;
    border-radius: 8px;
    background: #eff6ff;
    color: #1d4ed8;
    margin-top: 10px;
    font-size: 14px;
}

@media (max-width: 1000px) {
    .cards {
        grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .sidebar {
        width: 190px;
    }

    main {
        padding: 18px;
    }
}

@media (max-width: 600px) {
    header {
        padding: 15px;
    }

    header h2 {
        font-size: 17px;
    }

    .layout {
        display: block;
    }

    .sidebar {
        width: 100%;
        display: flex;
        overflow-x: auto;
        gap: 6px;
        padding: 10px;
        border-right: none;
        border-bottom: 1px solid #e2e8f0;
    }

    .sidebar h3 {
        display: none;
    }

    .sidebar button {
        width: auto;
        white-space: nowrap;
        margin: 0;
    }

    main {
        padding: 15px;
    }

    .cards {
        gap: 10px;
    }

    .card {
        padding: 15px;
    }

    .card h2 {
        font-size: 23px;
    }

    .quick-actions {
        grid-template-columns: repeat(2, minmax(0, 1fr));
    }
}
</style>
</head>

<body>

<header>
    <div>
        <h2>ST CARELS ACADEMY</h2>
        <p>School Management System | Excellency via faith</p>
    </div>

    <button class="logout" id="logoutButton">Logout</button>
</header>

<div class="layout">

    <nav class="sidebar" aria-label="Main navigation">
        <h3>MAIN MENU</h3>

        <button class="active" data-page="home">🏠 Dashboard</button>
        <button data-page="Students">👨‍🎓 Students</button>
        <button data-page="Teachers">👩‍🏫 Teachers</button>
        <button data-page="Classes">🏫 Classes</button>
        <button data-page="Subjects">📚 Subjects</button>
        <button data-page="Marks">📝 Examination Marks</button>
        <button data-page="Fees">💰 School Fees</button>
        <button data-page="Attendance">📋 Attendance</button>
        <button data-page="Reports">📊 Reports</button>
    </nav>

    <main>

        <section id="homePage">

            <div class="welcome">
                <h1>School Dashboard</h1>
                <p id="userInfo">Verifying your account...</p>
            </div>

            <div class="cards">

                <div class="card">
                    <p>Total Students</p>
                    <h2>—</h2>
                </div>

                <div class="card">
                    <p>Total Teachers</p>
                    <h2>—</h2>
                </div>

                <div class="card">
                    <p>Classes</p>
                    <h2>—</h2>
                </div>

                <div class="card">
                    <p>Subjects</p>
                    <h2>—</h2>
                </div>

            </div>

            <div class="panel">
                <h2>Quick Actions</h2>

                <div class="quick-actions">
                    <button class="action" data-page="Students">
                        + Students
                    </button>

                    <button class="action" data-page="Teachers">
                        + Teachers
                    </button>

                    <button class="action" data-page="Marks">
                        Enter Marks
                    </button>

                    <button class="action" data-page="Fees">
                        Record Fees
                    </button>

                    <button class="action" data-page="Attendance">
                        Take Attendance
                    </button>

                    <button class="action" data-page="Reports">
                        View Reports
                    </button>
                </div>
            </div>

            <div class="panel">
                <h2>System Status</h2>
                <div class="notice" id="systemStatus">
                    Checking authentication...
                </div>
            </div>

        </section>

        <section id="pageContent">
            <div class="welcome">
                <h1 id="sectionTitle">Management</h1>
                <p id="sectionDescription">
                    School management section.
                </p>
            </div>

            <div class="panel">
                <h2 id="panelTitle">Welcome</h2>

                <p id="panelDescription">
                    This section is ready for its management features.
                </p>

                <div class="notice">
                    Database records and management forms will appear here
                    after the corresponding Supabase tables and permissions
                    are configured.
                </div>
            </div>

            <button class="action" id="backButton">
                ← Back to Dashboard
            </button>
        </section>

    </main>
</div>

<footer>
    © 2026 St Carels Academy | Excellency via faith
</footer>

<script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>

<script>
"use strict";

// Use the SAME Supabase project and publishable key as login.html.
const SUPABASE_URL = "https://YOUR_PROJECT_ID.supabase.co";
const SUPABASE_PUBLISHABLE_KEY = "YOUR_SUPABASE_PUBLISHABLE_KEY";

const { createClient } = supabase;

const db = createClient(
    SUPABASE_URL,
    SUPABASE_PUBLISHABLE_KEY,
    {
        auth: {
            persistSession: true,
            autoRefreshToken: true,
            detectSessionInUrl: true
        }
    }
);

document.body.style.visibility = "hidden";

async function protectDashboard() {
    try {
        const { data, error } = await db.auth.getUser();

        if (error || !data.user) {
            window.location.replace("login.html");
            return;
        }

        document.getElementById("userInfo").textContent =
            "Signed in as " + data.user.email;

        document.getElementById("systemStatus").textContent =
            "Supabase authentication verified. Database management " +
            "features require their tables and security policies.";

        document.body.style.visibility = "visible";

    } catch (error) {
        window.location.replace("login.html");
    }
}

document.getElementById("logoutButton").addEventListener(
    "click",
    async function () {
        this.disabled = true;

        try {
            const { error } = await db.auth.signOut();

            if (error) {
                alert("Logout failed. Please try again.");
                this.disabled = false;
                return;
            }

            window.location.replace("login.html");

        } catch (error) {
            alert("Unable to connect. Please try again.");
            this.disabled = false;
        }
    }
);

const descriptions = {
    Students: "Register and manage learner information.",
    Teachers: "Manage teacher profiles and assignments.",
    Classes: "Organise PP1, PP2 and Grades 1–9.",
    Subjects: "Manage subjects and teacher allocations.",
    Marks: "Manage assessments and examination results.",
    Fees: "Manage fee balances and payments.",
    Attendance: "Record and review learner attendance.",
    Reports: "Prepare school performance and administrative reports."
};

function openPage(page) {
    const home = document.getElementById("homePage");
    const content = document.getElementById("pageContent");

    document.querySelectorAll(".sidebar button").forEach(button => {
        button.classList.toggle(
            "active",
            button.dataset.page === page
        );
    });

    if (page === "home") {
        home.style.display = "block";
        content.style.display = "none";
        return;
    }

    home.style.display = "none";
    content.style.display = "block";

    document.getElementById("sectionTitle").textContent = page;
    document.getElementById("panelTitle").textContent =
        page + " Management";

    document.getElementById("sectionDescription").textContent =
        descriptions[page] || "School management section.";

    document.getElementById("panelDescription").textContent =
        descriptions[page] ||
        "Manage school information from this section.";
}

document.querySelectorAll("[data-page]").forEach(button => {
    button.addEventListener("click", () => {
        openPage(button.dataset.page);
    });
});

document.getElementById("backButton").addEventListener(
    "click",
    () => openPage("home")
);

protectDashboard();
</script>

</body>
</html>




