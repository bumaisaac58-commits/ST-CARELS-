<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>St Carels Academy | Dashboard</title>
  <style>
    :root{--blue:#155eef;--navy:#12315a;--pale:#eef4ff;--ink:#172b4d;--muted:#667085;--line:#e4eaf2;--white:#fff}
    *{box-sizing:border-box} body{margin:0;font-family:Arial,Helvetica,sans-serif;background:#f5f8fc;color:var(--ink)}
    button,input{font:inherit} button{cursor:pointer}
    .layout{min-height:100vh;display:grid;grid-template-columns:250px 1fr}
    aside{background:var(--navy);color:white;padding:22px 15px;display:flex;flex-direction:column;gap:22px}
    .brand{display:flex;align-items:center;gap:12px;padding:0 8px 18px;border-bottom:1px solid #ffffff2b}
    .crest{width:44px;height:44px;border-radius:12px;background:#fff;color:var(--blue);display:grid;place-items:center;font-weight:900;font-size:18px}
    .brand h1{font-size:16px;line-height:1.25;margin:0}.brand small{display:block;font-size:11px;color:#c9d8f4;margin-top:5px}
    nav{display:grid;gap:7px} nav a{color:#dce8ff;text-decoration:none;padding:12px 13px;border-radius:9px;display:flex;gap:11px;align-items:center;font-size:14px}
    nav a:hover,nav a.active{background:#ffffff20;color:#fff} .nav-label{font-size:10px;letter-spacing:1.5px;color:#9eb6df;padding:10px 13px 2px}
    .side-bottom{margin-top:auto;color:#c9d8f4;font-size:12px;line-height:1.7;padding:12px}
    main{min-width:0}.topbar{height:72px;background:white;border-bottom:1px solid var(--line);display:flex;align-items:center;justify-content:space-between;padding:0 28px;gap:12px}
    .topbar h2{font-size:18px;margin:0}.top-actions{display:flex;align-items:center;gap:12px}.pill{background:#e8f8ef;color:#147443;border-radius:20px;padding:7px 10px;font-size:12px}
    .avatar{width:38px;height:38px;border-radius:50%;display:grid;place-items:center;background:var(--pale);color:var(--blue);font-weight:bold}
    .content{padding:28px;max-width:1400px;margin:auto}.welcome{display:flex;justify-content:space-between;align-items:center;gap:15px;margin-bottom:24px}
    .welcome h1{font-size:25px;margin:0 0 7px}.welcome p{color:var(--muted);margin:0;font-size:14px}
    .primary{border:0;border-radius:9px;background:var(--blue);color:white;padding:11px 15px;font-weight:700}.primary:hover{background:#0e4bc7}
    .cards{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:16px;margin-bottom:22px}
    .card,.panel{background:white;border:1px solid var(--line);border-radius:14px;padding:20px;box-shadow:0 3px 12px #1b3a5c08}
    .stat-top{display:flex;justify-content:space-between;align-items:center;color:var(--muted);font-size:13px}.icon{width:39px;height:39px;display:grid;place-items:center;border-radius:11px;background:var(--pale);font-size:19px}
    .number{font-size:28px;font-weight:800;margin:16px 0 7px}.sub{font-size:12px;color:var(--muted)}
    .grid{display:grid;grid-template-columns:1.25fr 1fr;gap:18px}.panel h3{margin:0 0 6px;font-size:17px}.panel .desc{font-size:13px;color:var(--muted);margin:0 0 18px}
    .quicklinks{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:12px}.quick{display:flex;align-items:center;gap:12px;padding:14px;border:1px solid var(--line);border-radius:10px;text-decoration:none;color:var(--ink)}
    .quick:hover{background:#f7faff;border-color:#b7ccff}.quick strong{font-size:13px;display:block}.quick small{font-size:11px;color:var(--muted);display:block;margin-top:4px}
    .activity{display:grid;gap:0}.activity-row{padding:13px 0;border-bottom:1px solid var(--line);display:flex;gap:12px;align-items:flex-start;font-size:13px}.activity-row:last-child{border:0}.dot{width:9px;height:9px;border-radius:50%;background:var(--blue);margin-top:4px;flex-shrink:0}.activity-row small{display:block;color:var(--muted);margin-top:5px}
    .notice{margin-top:18px;padding:14px 16px;border-radius:10px;background:#fff8e8;border:1px solid #f5dfaa;color:#795b15;font-size:13px;line-height:1.5}
    .footer{text-align:center;color:#8793a5;font-size:11px;padding:25px}
    .mobile-menu{display:none;border:0;background:var(--pale);color:var(--blue);border-radius:8px;padding:9px}
    @media(max-width:1000px){.cards{grid-template-columns:repeat(2,minmax(0,1fr))}.grid{grid-template-columns:1fr}}
    @media(max-width:700px){.layout{grid-template-columns:1fr}aside{display:none;position:fixed;z-index:5;inset:0 auto 0 0;width:260px;overflow:auto}aside.open{display:flex}.topbar{padding:0 15px;height:64px}.mobile-menu{display:block}.topbar h2{font-size:15px}.content{padding:20px 14px}.welcome{align-items:flex-start;flex-direction:column}.welcome h1{font-size:22px}.cards{gap:10px}.card{padding:15px}.number{font-size:24px}.quicklinks{grid-template-columns:1fr}.top-actions .pill{display:none}}
  </style>
</head>
<body>
<div class="layout">
  <aside id="sidebar">
    <div class="brand"><div class="crest">SC</div><div><h1>St Carels Academy</h1><small>Excellency via faith</small></div></div>
    <nav>
      <div class="nav-label">MAIN MENU</div>
      <a class="active" href="dashboard.html">▦ &nbsp; Dashboard</a>
      <a href="students.html">👨‍🎓 &nbsp; Students</a>
      <a href="teachers.html">👩‍🏫 &nbsp; Teachers</a>
      <a href="grades.html">📚 &nbsp; Classes & Grades</a>
      <div class="nav-label">ACADEMICS</div>
      <a href="marks.html">📝 &nbsp; Marks & Results</a>
      <a href="timetable.html">🗓️ &nbsp; Timetable</a>
      <a href="assignments.html">📋 &nbsp; Assignments</a>
      <a href="attendance.html">☑️ &nbsp; Attendance</a>
      <div class="nav-label">SCHOOL MANAGEMENT</div>
      <a href="fees.html">💳 &nbsp; Fees</a>
      <a href="admission.html">📄 &nbsp; Admissions</a>
      <a href="reports.html">📊 &nbsp; Reports</a>
      <a href="settings.html">⚙️ &nbsp; Settings</a>
    </nav>
    <div class="side-bottom">School Management Portal<br>Academic Year: <span id="yearSide"></span></div>
  </aside>
  <main>
    <header class="topbar">
      <div style="display:flex;align-items:center;gap:12px"><button class="mobile-menu" id="menuBtn" aria-label="Open menu">☰</button><h2>School Dashboard</h2></div>
      <div class="top-actions"><span class="pill" id="connectionStatus">Demo view</span><div class="avatar" id="userAvatar">SC</div><button class="primary" id="logoutBtn" style="padding:9px 12px">Log out</button></div>
    </header>
    <section class="content">
      <div class="welcome"><div><h1>Welcome to St Carels Academy</h1><p>Here is your school overview for today.</p></div><button class="primary" onclick="window.location.href='admission.html'">＋ Register Student</button></div>
      <div class="cards">
        <div class="card"><div class="stat-top"><span>Total Students</span><span class="icon">🎓</span></div><div class="number" id="studentsCount">—</div><div class="sub">Registered learners</div></div>
        <div class="card"><div class="stat-top"><span>Teachers</span><span class="icon">👩‍🏫</span></div><div class="number" id="teachersCount">—</div><div class="sub">Teaching staff</div></div>
        <div class="card"><div class="stat-top"><span>Classes / Grades</span><span class="icon">🏫</span></div><div class="number" id="classesCount">9</div><div class="sub">PP1 to Grade 9 (edit as needed)</div></div>
        <div class="card"><div class="stat-top"><span>Pending Fees</span><span class="icon">💳</span></div><div class="number" id="feesCount">—</div><div class="sub">Connect your fees table to show totals</div></div>
      </div>
      <div class="grid">
        <section class="panel"><h3>Quick Actions</h3><p class="desc">Open a school management section.</p>
          <div class="quicklinks">
            <a class="quick" href="admission.html"><span class="icon">➕</span><span><strong>Admit a learner</strong><small>Register a new student</small></span></a>
            <a class="quick" href="teachers.html"><span class="icon">👩‍🏫</span><span><strong>Manage teachers</strong><small>View and update staff</small></span></a>
            <a class="quick" href="marks.html"><span class="icon">📝</span><span><strong>Enter examination marks</strong><small>Manage learner results</small></span></a>
            <a class="quick" href="timetable.html"><span class="icon">🗓️</span><span><strong>View timetable</strong><small>Lessons and activities</small></span></a>
            <a class="quick" href="attendance.html"><span class="icon">☑️</span><span><strong>Record attendance</strong><small>Track daily attendance</small></span></a>
            <a class="quick" href="reports.html"><span class="icon">📊</span><span><strong>School reports</strong><small>Review school records</small></span></a>
          </div>
        </section>
        <section class="panel"><h3>School Updates</h3><p class="desc">Reminders for school administrators.</p>
          <div class="activity">
            <div class="activity-row"><span class="dot"></span><div><strong>Check learner records</strong><small>Keep student details up to date.</small></div></div>
            <div class="activity-row"><span class="dot"></span><div><strong>Review assessment marks</strong><small>Confirm marks before preparing reports.</small></div></div>
            <div class="activity-row"><span class="dot"></span><div><strong>Update attendance</strong><small>Record attendance daily.</small></div></div>
            <div class="activity-row"><span class="dot"></span><div><strong>Back up school data</strong><small>Confirm your database access and security policies.</small></div></div>
          </div>
        </section>
      </div>
      <div class="notice" id="notice"><strong>Connection note:</strong> This dashboard layout works on its own. To display live student and teacher totals, connect it to your Supabase project and use table names that match your database.</div>
      <div class="footer">© <span id="year"></span> St Carels Academy • Excellency via faith</div>
    </section>
  </main>
</div>
<script>
  // Optional Supabase connection:
  // 1. Create supabase.js with your project URL and publishable/anon key.
  // 2. Load the Supabase v2 CDN, then supabase.js, then this page's script.
  // 3. Ensure your tables and Row Level Security policies allow the signed-in user
  //    to read only the records they are permitted to access.
  const $ = (id) => document.getElementById(id);
  $('year').textContent = new Date().getFullYear();
  $('yearSide').textContent = new Date().getFullYear();
  $('menuBtn').addEventListener('click', () => $('sidebar').classList.toggle('open'));

  // This starter intentionally does not invent database credentials or table schemas.
  // Once Supabase is initialized, add your project-specific queries here.
  const supabaseClient = window.supabaseClient || window.sb || window.supabase;
  if (supabaseClient && typeof supabaseClient.from === 'function') {
    $('connectionStatus').textContent = 'Supabase client found';
    $('connectionStatus').style.background = '#e8f8ef';
    $('connectionStatus').style.color = '#147443';
    $('notice').innerHTML = '<strong>Supabase client detected.</strong> Add queries below using your exact table names to load live totals.';
  }

  $('logoutBtn').addEventListener('click', async () => {
    try {
      const client = window.supabaseClient || window.sb || window.supabase;
      if (client && client.auth && typeof client.auth.signOut === 'function') {
        await client.auth.signOut();
      }
    } catch (error) {
      console.error('Sign out error:', error);
    }
    // Change login.html if your actual login page uses another filename.
    window.location.href = 'login.html';
  });
</script>
</body>
</html>
