 <div><label>Message template</label><select id="smsTemplate"><option value="">Choose template</option><option value="fees">School fees reminder</option><option value="meeting">Parents meeting</option><option value="exam">Examination notice</option><option value="opening">School opening</option><option value="closing">School closing</option><option value="attendance">Attendance notice</option><option value="results">Exam results ready</option><option value="general">General announcement</option></select></div>
 <div><label>School name</label><input id="smsSchool" value="St Carels Academy"></div>
 <div><label>Date / deadline</label><input id="smsDate" type="date"></div>
 <div><label>Learner name (optional)</label><input id="smsLearner" placeholder="Learner name"></div>
 <div><label>Grade (optional)</label><select id="smsClass"><option value="">Select grade</option>${analysisGrades.map(g=>`<option>${escapeHTML(g)}</option>`).join("")}</select></div>
