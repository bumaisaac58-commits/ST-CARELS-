 };
 function values(){
  const d=$s("smsDate").value;
  return {parent_name:$s("smsRecipientName").value.trim()||"Parent/Guardian",learner_name:$s("smsLearner").value.trim()||"your child",grade:$s("smsClass").value||"your class",school_name:$s("smsSchool").value.trim()||"St Carels Academy",date:d?new Date(d+"T00:00:00").toLocaleDateString():"the stated date",amount:$s("smsAmount").value||"the stated amount",extra:$s("smsExtra").value.trim()};
 }
 function personalise(t){const v=values();return t.replace(/\{\{(parent_name|learner_name|grade|school_name|date|amount|extra)\}\}/g,(_,k)=>v[k]||"").replace(/\s{2,}/g," ").replace(/\s+([,.])/g,"$1").trim();}
 function count(){const n=$s("smsMessage").value.length;const ascii=/^[\x00-\x7F]*$/.test($s("smsMessage").value);const seg=n===0?0:ascii?(n<=160?1:Math.ceil(n/153)):(n<=70?1:Math.ceil(n/67));$s("smsCount").textContent=`${n} characters · ${seg} SMS segment${seg===1?"":"s"} (estimate)`;}
