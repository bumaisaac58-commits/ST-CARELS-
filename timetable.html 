<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>St Carels | Editable Timetable Generator</title>
<style>
:root{--blue:#0756a5;--blue2:#0878df;--ink:#12345a;--bg:#f3f7fc;--line:#d8e6f5;--green:#079669;--orange:#f59e0b;--red:#dc3545}
*{box-sizing:border-box}
body{margin:0;font-family:Arial,Helvetica,sans-serif;background:var(--bg);color:var(--ink)}
header{background:linear-gradient(115deg,#064a98,#0879d5);color:#fff;padding:17px 22px;display:flex;align-items:center;justify-content:space-between;gap:14px;flex-wrap:wrap}
.brand{display:flex;align-items:center;gap:13px}.crest{font-size:36px;background:#fff;color:var(--blue);border-radius:12px;padding:8px}.brand h1{font-size:21px;margin:0 0 5px}.brand p{margin:0;font-size:13px;opacity:.92}.title h2{margin:0;font-size:22px}.title p{margin:5px 0 0;font-size:13px}
main{max-width:1500px;margin:0 auto;padding:20px}
.panel{background:#fff;border:1px solid var(--line);border-radius:12px;padding:18px;margin-bottom:18px;box-shadow:0 3px 12px #15385b0a}
.panel h3{margin:0 0 15px;color:var(--blue);font-size:18px}
.controls{display:grid;grid-template-columns:repeat(4,minmax(130px,1fr));gap:13px}
label{display:block;font-weight:700;font-size:13px;margin-bottom:6px}
input,select,textarea{font:inherit;width:100%;padding:10px;border:1px solid #cbd9e8;border-radius:7px;background:#fff;color:#17385e}
.actions{display:flex;gap:9px;flex-wrap:wrap;align-items:end;margin-top:15px}
button{border:0;border-radius:7px;padding:11px 14px;font-weight:700;cursor:pointer;color:#fff;background:var(--blue2)}
button:hover{filter:brightness(.95)}button.green{background:var(--green)}button.orange{background:var(--orange);color:#18212d}button.gray{background:#64748b}button.red{background:var(--red)}
.notice{font-size:13px;color:#526981;line-height:1.5;margin:12px 0 0}
.table-wrap{overflow:auto;border:1px solid var(--line);border-radius:8px}
table{width:100%;border-collapse:separate;border-spacing:2px;min-width:760px;background:#e5eef8}
th{background:#0874d3;color:white;padding:12px 8px;text-align:center;font-size:13px}
td{background:#fff;text-align:center;padding:0;min-width:125px}
td.time{font-weight:700;color:#084b91;background:#eef7ff;padding:11px 7px;min-width:112px;white-space:nowrap}
.cell{width:100%;height:100%;min-height:45px;border:0;border-radius:0;text-align:center;font-size:13px;padding:8px 5px;outline-offset:-3px}
.cell:focus{outline:2px solid #0756a5}
.break-cell{background:#f8d9ec!important;font-weight:bold}
.table-head{display:flex;align-items:center;justify-content:space-between;gap:12px;flex-wrap:wrap}
.table-head h3{margin:0}
.status{font-size:12px;color:#526981}
.bottom-grid{display:grid;grid-template-columns:1.3fr 1fr;gap:18px}
.subject-list{display:flex;flex-wrap:wrap;gap:8px;margin-top:10px}
.chip{display:flex;align-items:center;gap:7px;background:#f7fafc;border:1px solid var(--line);border-radius:7px;padding:6px 8px;font-size:13px}
.chip input[type=color]{width:24px;height:24px;padding:0;border:0;background:none}
.chip input[type=text]{width:120px;padding:6px}
.chip button{padding:5px 8px;font-size:12px}
footer{text-align:center;padding:17px;color:#59708a;font-size:13px}
@media(max-width:850px){.controls{grid-template-columns:repeat(2,minmax(0,1fr))}.bottom-grid{grid-template-columns:1fr}.title{width:100%}main{padding:12px}}
@media(max-width:480px){.controls{grid-template-columns:1fr}.brand h1{font-size:17px}.title h2{font-size:19px}.panel{padding:13px}}
@media print{header .no-print,.controls-panel,.subjects-panel,.actions,.notice,footer{display:none!important}body{background:#fff}main{padding:0;max-width:none}.panel{border:0;box-shadow:none;padding:0}.table-wrap{overflow:visible;border:0}table{min-width:0;width:100%;font-size:10px}th{print-color-adjust:exact;-webkit-print-color-adjust:exact}td,th{break-inside:avoid}.cell{min-height:30px;padding:4px;font-size:10px;print-color-adjust:exact;-webkit-print-color-adjust:exact}.table-head{margin-bottom:8px}}
</style>
</head>
<body>
<header>
  <div class="brand"><div class="crest">📘</div><div><h1>ST CARELS UMOJA KWANZA</h1><p>School Management System · <em>Excellency via faith</em></p></div></div>
  <div class="title"><h2>🗓️ Timetable Generator</h2><p>Create · Edit · Save · Print</p></div>
  <button class="no-print gray" id="logoutBtn" type="button">Back to Dashboard</button>
</header>
<main>
<section class="panel controls-panel">
  <h3>⚙️ Timetable Setup</h3>
  <div class="controls">
    <div><label for="schoolYear">Academic year</label><input id="schoolYear" value="2026"></div>
    <div><label for="term">Term</label><select id="term"><option>Term 1</option><option>Term 2</option><option selected>Term 3</option></select></div>
    <div><label for="grade">Class / Grade</label><select id="grade"><option>PP1</option><option>PP2</option><option>Grade 1</option><option>Grade 2</option><option>Grade 3</option><option selected>Grade 4</option><option>Grade 5</option><option>Grade 6</option><option>Grade 7</option><option>Grade 8</option><option>Grade 9</option></select></div>
    <div><label for="days">School days</label><select id="days"><option value="5">Monday–Friday (5 days)</option><option value="6">Monday–Saturday (6 days)</option></select></div>
    <div><label for="start">Start time</label><input id="start" type="time" value="08:00"></div>
    <div><label for="end">End time</label><input id="end" type="time" value="15:30"></div>
    <div><label for="duration">Lesson length (minutes)</label><select id="duration"><option value="30">30 minutes</option><option value="35">35 minutes</option><option value="40">40 minutes</option><option value="45" selected>45 minutes</option><option value="60">60 minutes</option></select></div>
    <div><label for="breakAfter">Break after lesson number</label><select id="breakAfter"><option value="2">2 lessons</option><option value="3" selected>3 lessons</option><option value="4">4 lessons</option></select></div>
  </div>
  <div class="actions">
    <button id="generateBtn" type="button">⚙ Generate Timetable</button>
    <button id="saveBtn" class="green" type="button">💾 Save Timetable</button>
    <button id="csvBtn" class="gray" type="button">⬇ Download CSV</button>
    <button id="printBtn" class="orange" type="button">🖨 Print / Save PDF</button>
    <button id="clearBtn" class="red" type="button">Clear Timetable</button>
  </div>
  <p class="notice">Editable: tap any subject cell and type a different subject, teacher, or activity. Use Generate to create a fresh suggested arrangement. Save stores this timetable in this browser on this device. Use Print / Save PDF to print or save as PDF.</p>
</section>

<section class="panel">
  <div class="table-head">
    <h3 id="tableTitle">Grade 4 — Term 3 Timetable (2026)</h3>
    <span class="status" id="status">Ready</span>
  </div>
  <div class="table-wrap" style="margin-top:14px">
    <table id="timetable" aria-label="Editable school timetable"><thead></thead><tbody></tbody></table>
  </div>
</section>

<div class="bottom-grid">
  <section class="panel subjects-panel">
    <h3>🎨 Subjects and Colours</h3>
    <p class="notice">Change subject names or colours here, then generate or edit the timetable. Add any school subject or activity.</p>
    <div id="subjectList" class="subject-list"></div>
    <div class="actions">
      <input id="newSubject" type="text" placeholder="New subject / activity" style="max-width:250px">
      <button id="addSubjectBtn" type="button">+ Add Subject</button>
    </div>
  </section>
  <section class="panel">
    <h3>✍️ Editing Instructions</h3>
    <ol class="notice" style="padding-left:20px">
      <li>Choose the academic year, term, grade and school hours.</li>
      <li>Press <b>Generate Timetable</b> to make a suggested timetable automatically.</li>
      <li>Tap a cell and edit its text directly.</li>
      <li>Press <b>Save Timetable</b> to keep the current version in this browser.</li>
      <li>Download CSV to open the timetable in Excel or Google Sheets.</li>
      <li>Print / Save PDF to create a printable copy.</li>
    </ol>
    <p class="notice"><b>Note:</b> Automatic generation creates a balanced suggestion; check teacher availability, double lessons, and school-specific requirements before publishing.</p>
  </section>
</div>
</main>
<footer>St Carels Umoja Kwanza · Excellency via faith</footer>
<script>
const DEFAULT_SUBJECTS = [
  {name:"English",color:"#a8dcff"},{name:"Mathematics",color:"#ffd77d"},
  {name:"Science",color:"#8ce6b0"},{name:"Kiswahili",color:"#c6b5ff"},
  {name:"Social Studies",color:"#72e2ed"},{name:"CRE",color:"#ffc99f"},
  {name:"Creative Arts",color:"#f4b3dd"},{name:"ICT",color:"#ffb5c0"},
  {name:"PE & Sports",color:"#c2efb2"},{name:"Reading",color:"#dcb5d0"}
];
let subjects = DEFAULT_SUBJECTS.map(x=>({...x}));
let slots = [];
let days = ["Monday","Tuesday","Wednesday","Thursday","Friday"];
const $ = id => document.getElementById(id);
const toMinutes = t => {const [h,m]=t.split(":").map(Number);return h*60+m};
const toTime = n => `${String(Math.floor(n/60)).padStart(2,"0")}:${String(n%60).padStart(2,"0")}`;
function setStatus(s){$("status").textContent=s}
function renderSubjectList(){
  const root=$("subjectList");root.innerHTML="";
  subjects.forEach((s,i)=>{
    const chip=document.createElement("div");chip.className="chip";
    const color=document.createElement("input");color.type="color";color.value=s.color;
    color.title="Change "+s.name+" colour";color.addEventListener("input",()=>{s.color=color.value;paintCells()});
    const name=document.createElement("input");name.type="text";name.value=s.name;name.setAttribute("aria-label","Subject name");
    name.addEventListener("change",()=>{const old=s.name;s.name=name.value.trim()||old;document.querySelectorAll(".cell").forEach(c=>{if(c.value===old)c.value=s.name});renderSubjectList();paintCells();});
    const del=document.createElement("button");del.className="red";del.type="button";del.textContent="×";del.title="Remove subject";
    del.addEventListener("click",()=>{if(subjects.length<=1){alert("Keep at least one subject.");return}subjects.splice(i,1);renderSubjectList();paintCells()});
    chip.append(color,name,del);root.append(chip);
  });
}
function buildSlots(){
  const start=toMinutes($("start").value),end=toMinutes($("end").value),duration=Number($("duration").value),breakAfter=Number($("breakAfter").value);
  if(end<=start){alert("End time must be later than start time.");return null}
  let result=[],cursor=start,lesson=0;
  while(cursor+duration<=end && result.length<16){
    lesson++;
    result.push({time:`${toTime(cursor)} – ${toTime(cursor+duration)}`,break:false});
    cursor+=duration;
    if(lesson===breakAfter && cursor+15<=end){
      result.push({time:`${toTime(cursor)} – ${toTime(cursor+15)}`,break:true});
      cursor+=15;
    }
  }
  if(!result.length){alert("The selected school hours are too short for a lesson.");return null}
  return result;
}
function makeHeader(){
  const head=$("timetable").querySelector("thead");head.innerHTML="";
  const tr=document.createElement("tr");
  ["Time",...days].forEach(d=>{const th=document.createElement("th");th.textContent=d;tr.append(th)});
  head.append(tr);
}
function renderTable(){
  makeHeader();
  const body=$("timetable").querySelector("tbody");body.innerHTML="";
  slots.forEach((slot,r)=>{
    const tr=document.createElement("tr");
    const time=document.createElement("td");time.className="time";time.textContent=slot.time;tr.append(time);
    days.forEach((day,c)=>{
      const td=document.createElement("td");
      const input=document.createElement("input");input.className="cell";input.type="text";
      input.value=slot.break?"BREAK":(slot.values?.[c]||"");
      input.setAttribute("aria-label",`${day}, ${slot.time}`);
      if(slot.break){input.classList.add("break-cell");input.readOnly=true}
      input.addEventListener("input",()=>{slot.values=slot.values||Array(days.length).fill("");slot.values[c]=input.value;paintOne(input)});
      td.append(input);tr.append(td);
    });
    body.append(tr);
  });
  paintCells();
  $("tableTitle").textContent=`${$("grade").value} — ${$("term").value} Timetable (${ $("schoolYear").value })`;
}
function paintOne(input){
  const s=subjects.find(x=>x.name.toLowerCase()===input.value.trim().toLowerCase());
  input.style.background=s?s.color:(input.value.trim().toUpperCase()==="BREAK"?"#f8d9ec":"#fff");
}
function paintCells(){document.querySelectorAll(".cell").forEach(paintOne)}
function generate(){
  const nextDays=Number($("days").value)===6?["Monday","Tuesday","Wednesday","Thursday","Friday","Saturday"]:["Monday","Tuesday","Wednesday","Thursday","Friday"];
  const newSlots=buildSlots();if(!newSlots)return;
  days=nextDays;slots=newSlots;
  let recent=Array(days.length).fill("");
  slots.forEach((slot,i)=>{
    if(slot.break){slot.values=days.map(()=>"BREAK");return}
    slot.values=days.map((day,d)=>{
      if(!subjects.length)return "Study";
      let pool=subjects.filter(s=>s.name!==recent[d]);
      if(!pool.length)pool=subjects;
      // deterministic rotation makes the timetable reasonably balanced and repeatable
      const chosen=pool[(i*2+d*3+Math.floor(i/3))%pool.length].name;
      recent[d]=chosen;return chosen;
    });
  });
  renderTable();setStatus("Generated — review and save");
}
function save(){
  const data={schoolYear:$("schoolYear").value,term:$("term").value,grade:$("grade").value,days:$("days").value,start:$("start").value,end:$("end").value,duration:$("duration").value,breakAfter:$("breakAfter").value,subjects,slots,dayNames:days};
  try{localStorage.setItem("stCarelsTimetableV1",JSON.stringify(data));setStatus("Saved on this device at "+new Date().toLocaleTimeString());}
  catch(e){alert("Could not save in this browser. Try downloading the CSV instead.");}
}
function loadSaved(){
  try{
    const raw=localStorage.getItem("stCarelsTimetableV1");if(!raw)return false;
    const d=JSON.parse(raw);
    ["schoolYear","term","grade","days","start","end","duration","breakAfter"].forEach(k=>{if(d[k]!==undefined)$(k).value=d[k]});
    if(d.subjects?.length)subjects=d.subjects;
    if(d.slots?.length){slots=d.slots;days=d.dayNames||days;renderSubjectList();renderTable();setStatus("Loaded saved timetable");return true}
  }catch(e){}
  return false;
}
function downloadCSV(){
  const rows=[["Time",...days]];
  slots.forEach(s=>rows.push([s.time,...(s.values||days.map(()=>s.break?"BREAK":""))]));
  const csv=rows.map(row=>row.map(v=>`"${String(v??"").replace(/"/g,'""')}"`).join(",")).join("\r\n");
  const blob=new Blob(["\uFEFF"+csv],{type:"text/csv;charset=utf-8;"}),url=URL.createObjectURL(blob);
  const a=document.createElement("a");a.href=url;a.download=`${$("grade").value.replace(/\s/g,"_")}_${$("term").value.replace(/\s/g,"_")}_timetable.csv`;a.click();URL.revokeObjectURL(url);
}
$("generateBtn").addEventListener("click",generate);
$("saveBtn").addEventListener("click",save);
$("csvBtn").addEventListener("click",downloadCSV);
$("printBtn").addEventListener("click",()=>window.print());
$("clearBtn").addEventListener("click",()=>{if(confirm("Clear the timetable cells? This does not delete the saved copy.")){slots.forEach(s=>{s.values=days.map(()=>"")});renderTable();setStatus("Cleared — generate or edit a timetable")}});
$("addSubjectBtn").addEventListener("click",()=>{const name=$("newSubject").value.trim();if(!name)return;if(subjects.some(s=>s.name.toLowerCase()===name.toLowerCase())){alert("That subject already exists.");return}subjects.push({name,color:"#dbeafe"});$("newSubject").value="";renderSubjectList();paintCells()});
$("logoutBtn").addEventListener("click",()=>{if(confirm("Return to the school dashboard?")){window.location.href="dashboard.html"}});
["grade","term","schoolYear"].forEach(id=>$(id).addEventListener("change",()=>{$("tableTitle").textContent=`${$("grade").value} — ${$("term").value} Timetable (${ $("schoolYear").value })`}));
renderSubjectList();
if(!loadSaved())generate();
</script>
</body>
</html>